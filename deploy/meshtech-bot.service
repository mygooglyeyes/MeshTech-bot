# MeshTech-Bot systemd unit (template - install.sh fills in the {PLACEHOLDERS}).
# Installed to /etc/systemd/system/meshtech-bot.service by ./install.sh.
[Unit]
Description=MeshTech-Bot - MeshCore answer bot (openHop companion client)
Documentation=file://{INSTALL_DIR}/docs/INSTALL.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The bot runs as its own unprivileged account, never as root.
User={USER}
Group={GROUP}
WorkingDirectory={INSTALL_DIR}
ExecStart={PYTHON} bot.py
Restart=on-failure
RestartSec=5
# Hardening: the bot only needs to write its data folder at runtime, so
# the whole install (code, venv, config) is mounted read-only for it.
# Flags are conservative - unknown options on older systemd are ignored.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths={INSTALL_DIR}/data
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
